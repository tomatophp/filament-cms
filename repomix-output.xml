            \Spatie\MediaLibrary\MediaLibraryServiceProvider::class,
            FilamentCmsServiceProvider::class,
            AdminPanelProvider::class,
        ];

        sort($providers);

        return $providers;
    }

    protected function defineEnvironment($app)
